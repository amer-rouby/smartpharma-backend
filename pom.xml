<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.0</version>
		<relativePath/>
	</parent>

	<groupId>com.smartpharma</groupId>
	<artifactId>smartpharma-backend</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	<name>SmartPharma Backend</name>
	<description>Smart Pharmacy Management System</description>

	<modules>
		<module>smartpharma-common</module>
		<module>smartpharma-license</module>
		<module>smartpharma-settings</module>
		<module>smartpharma-payments</module>
		<module>smartpharma-expenses</module>
		<module>smartpharma-auth</module>
		<module>smartpharma-catalog</module>
		<module>smartpharma-purchasing</module>
		<module>smartpharma-sales</module>
		<module>smartpharma-notifications</module>
		<module>smartpharma-einvoice</module>
		<module>smartpharma-platform</module>
		<module>smartpharma-app</module>
	</modules>

	<properties>
		<java.version>17</java.version>
		<lombok.version>1.18.30</lombok.version>
		<mapstruct.version>1.5.5.Final</mapstruct.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.smartpharma</groupId>
				<artifactId>smartpharma-common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.smartpharma</groupId>
				<artifactId>smartpharma-license</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.smartpharma</groupId>
				<artifactId>smartpharma-settings</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.smartpharma</groupId>
				<artifactId>smartpharma-payments</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.smartpharma</groupId>
				<artifactId>smartpharma-expenses</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.smartpharma</groupId>
				<artifactId>smartpharma-auth</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.smartpharma</groupId>
				<artifactId>smartpharma-catalog</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.smartpharma</groupId>
				<artifactId>smartpharma-purchasing</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.smartpharma</groupId>
				<artifactId>smartpharma-sales</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.smartpharma</groupId>
				<artifactId>smartpharma-notifications</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.smartpharma</groupId>
				<artifactId>smartpharma-einvoice</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.smartpharma</groupId>
				<artifactId>smartpharma-platform</artifactId>
				<version>${project.version}</version>
			</dependency>

			<dependency>
				<groupId>com.microsoft.playwright</groupId>
				<artifactId>playwright</artifactId>
				<version>1.62.0</version>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-api</artifactId>
				<version>0.11.5</version>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-impl</artifactId>
				<version>0.11.5</version>
				<scope>runtime</scope>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-jackson</artifactId>
				<version>0.11.5</version>
				<scope>runtime</scope>
			</dependency>
			<dependency>
				<groupId>org.apache.poi</groupId>
				<artifactId>poi-ooxml</artifactId>
				<version>5.4.0</version>
			</dependency>
			<dependency>
				<groupId>com.github.librepdf</groupId>
				<artifactId>openpdf</artifactId>
				<version>1.3.30</version>
			</dependency>
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct</artifactId>
				<version>${mapstruct.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>2.3.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.11.0</version>
					<configuration>
						<source>${java.version}</source>
						<target>${java.version}</target>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>${lombok.version}</version>
							</path>
							<path>
								<groupId>org.mapstruct</groupId>
								<artifactId>mapstruct-processor</artifactId>
								<version>${mapstruct.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
