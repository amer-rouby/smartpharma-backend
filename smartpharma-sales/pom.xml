<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.smartpharma</groupId>
		<artifactId>smartpharma-backend</artifactId>
		<version>1.0.0</version>
	</parent>

	<artifactId>smartpharma-sales</artifactId>
	<packaging>jar</packaging>
	<name>SmartPharma Sales</name>
	<description>POS sales transactions, prescription uploads and sales analytics</description>

	<dependencies>
		<dependency>
			<groupId>com.smartpharma</groupId>
			<artifactId>smartpharma-common</artifactId>
		</dependency>
		<dependency>
			<groupId>com.smartpharma</groupId>
			<artifactId>smartpharma-settings</artifactId>
		</dependency>
		<dependency>
			<groupId>com.smartpharma</groupId>
			<artifactId>smartpharma-catalog</artifactId>
		</dependency>
		<dependency>
			<groupId>com.smartpharma</groupId>
			<artifactId>smartpharma-payments</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>
</project>
